{
  "name": "ulogi",
  "productName": "ULogi",
  "version": "1.0.0",
  "description": "A desktop app for managing notes and tasks.",
  "main": "./dist/main.entry.js",
  "scripts": {
    "dev:start": "scripty",
    "dev:ele": "scripty",
    "dev:tsc": "scripty",
    "build:tsc": "scripty",
    "build:socks": "scripty",
    "build:ele-simple": "scripty",
    "build:ele": "scripty",
    "build:release": "scripty",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix "
  },
  "build": {
    "productName": "fb-note-electron",
    "appId": "fb.note.electron",
    "asar": true,
    "files": [
      "./assets/*",
      "./main.js",
      "./constants.js"
    ],
    "extraResources": [
      {
        "from": "preload.js",
        "to": "./support/preload/preload.js"
      },
      {
        "from": "build-service",
        "to": "./support/build-service"
      },
      {
        "from": "logs",
        "to": "./support/logs"
      },
      {
        "from": "temps",
        "to": "./support/temps"
      },
      {
        "from": "../web-app/build",
        "to": "web-app/build"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "chalk": "^4.1.2",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.5",
    "default-gateway": "^7.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.3",
    "mammoth": "^1.9.0",
    "morgan": "^1.10.0",
    "sharp": "^0.33.5",
    "socks5-server": "^0.1.1",
    "tesseract.js": "^5.1.1",
    "undici": "^6.20.1",
    "winston": "^3.16.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/default-gateway": "^7.2.2",
    "@types/express": "^5.0.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/resolve": "^1.20.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.25.2",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "rollup": "^4.40.0",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-node-globals": "^1.4.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "scripty": "^2.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}
