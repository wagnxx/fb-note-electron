{
  "name": "fb-note",
  "version": "1.0.0",
  "description": "A desktop app for managing notes and tasks.",
  "main": "dist/main.js",
  "scripts": {
    "build:src": "rollup -c",
    "build:src-w": "rollup -c -w",
    "start:ele": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "build:socks": "mkdir -p ./build-service && pkg ./socks-server.js --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --out=./build-service/socks-server",
    "build:ele-simple": "electron-builder",
    "build:ele": "electron-builder --config=electron.build.config.js"
  },
  "build": {
    "productName": "fb-note-electron",
    "appId": "fb.note.electron",
    "asar": true,
    "files": [
      "./assets/*",
      "./main.js",
      "./constants.js"
    ],
    "extraResources": [
      {
        "from": "preload.js",
        "to": "./support/preload/preload.js"
      },
      {
        "from": "build-service",
        "to": "./support/build-service"
      },
      {
        "from": "logs",
        "to": "./support/logs"
      },
      {
        "from": "temps",
        "to": "./support/temps"
      },
      {
        "from": "../web-app/build",
        "to": "web-app/build"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.3",
    "socks5-server": "^0.1.1",
    "undici": "^6.20.1",
    "winston": "^3.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rollup": "^4.24.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}