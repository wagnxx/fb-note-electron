{
  "name": "fb-note",
  "version": "1.0.0",
  "description": "A desktop app for managing notes and tasks.",
  "main": "dist/main.js",
  "scripts": {
    "dev:start": "scripty",
    "dev:ele": "scripty",
    "build:tsc": "scripty",
    "build:rollup": "scripty",
    "build:rollup-w": "scripty",
    "build:socks": "scripty",
    "build:ele-simple": "scripty",
    "build:ele": "scripty"
  },
  "build": {
    "productName": "fb-note-electron",
    "appId": "fb.note.electron",
    "asar": true,
    "files": [
      "./assets/*",
      "./main.js",
      "./constants.js"
    ],
    "extraResources": [
      {
        "from": "preload.js",
        "to": "./support/preload/preload.js"
      },
      {
        "from": "build-service",
        "to": "./support/build-service"
      },
      {
        "from": "logs",
        "to": "./support/logs"
      },
      {
        "from": "temps",
        "to": "./support/temps"
      },
      {
        "from": "../web-app/build",
        "to": "web-app/build"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.33.5",
    "socks5-server": "^0.1.1",
    "tesseract.js": "^5.1.1",
    "undici": "^6.20.1",
    "winston": "^3.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rollup": "^4.24.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "scripty": "^2.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}